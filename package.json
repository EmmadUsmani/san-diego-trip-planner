{
  "name": "san-diego-trip-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "tsx db/make-seed.ts && wrangler d1 execute DB --local --file db/seed.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate:local && pnpm db:seed:local",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "adhan": "^4.4.6",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.14",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.155.0"
  }
}